{
  "rule_title": "TTP 1562.004 - Windows Firewall Disablement",
  "description": "Detects various methods of disabling the Windows Firewall via CLI, PowerShell, or direct policy changes.",
  "logic": "OR",
  "severity": "high",
  "detection": [
    {
      "logic": "AND",
      "detection": [
        { "field": "EventID", "op": "eq", "value": "4688" },
        { "field": "ED_CommandLine", "op": "contains", "value": "advfirewall" },
        { "field": "ED_CommandLine", "op": "contains", "value": "off" }
      ]
    },
    {
      "logic": "AND",
      "detection": [
        { "field": "EventID", "op": "in", "value": ["4104", "4103"] },
        { "field": "ED_ScriptBlockText", "op": "contains", "value": "Set-NetFirewallProfile" },
        { "field": "ED_ScriptBlockText", "op": "contains", "value": "False" }
      ]
    }
  ]
}