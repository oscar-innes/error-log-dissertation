{
    "rule_title": "TTP 1543.003 - New Service Created",
    "description": "Detects new service creation using sc.exe create or reg.exe writing to the Services hive — the command-line service creation path used by attackers when installing persistence or execution services without using the SCM API directly.",
    "logic": "OR",
    "severity": "medium",
    "detection": [
      {
        "logic": "AND",
        "detection": [
          { "field": "EventID", "op": "eq", "value": "4688" },
          { "field": "Channel", "op": "eq", "value": "Security" },
          { "field": "ED_NewProcessName", "op": "endswith", "value": "\\sc.exe" },
          { "field": "ED_CommandLine", "op": "contains", "value": "create" }
        ]
      },
      {
        "logic": "AND",
        "detection": [
          { "field": "EventID", "op": "eq", "value": "4688" },
          { "field": "Channel", "op": "eq", "value": "Security" },
          { "field": "NewProcessName", "op": "endswith", "value": "\\reg.exe" },
          { "field": "ED_CommandLine", "op": "contains", "value": "\\Services\\" },
          { "field": "ED_CommandLine", "op": "contains", "value": "ImagePath" },
          { "field": "ED_CommandLine", "op": "contains", "value": "/d" }
        ]
      },
      {
      "logic": "AND",
        "detection": [
          { "field": "EventID", "op": "eq", "value": "4104" },
          { "field": "Channel", "op": "eq", "value": "Microsoft-Windows-PowerShell/Operational" },
          { "field": "ED_ScriptBlockText", "op": "in", "value": [
              "New-Service",
              "Win32_Service",
              "CreateService"
            ]
          }
    ]
    
      },
      {
        "logic": "AND",
        "detection": [
          { "field": "EventID", "op": "eq", "value": "800" },
          { "field": "Channel", "op": "eq", "value": "Windows PowerShell" },
          { "field": "ED_RawData", "op": "contains", "value": "New-Service" }
        ]
      }

    ]
}