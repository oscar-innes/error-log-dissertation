{
    "rule_title": "TTP T1222.002 - File Permissions Modification via icacls.exe",
    "description": "Detects icacls.exe granting Everyone:F (full control) with /T (recursive) and /Q (quiet).",
    "logic": "AND",
    "severity": "high",
    "detection": [
      { "field": "EventID", "op": "eq", "value": "1" },
        { "field": "Channel", "op": "eq", "value": "Microsoft-Windows-Sysmon/Operational" },
      {
        "field": "ED_Image",
        "op": "endswith",
        "value": "\\icacls.exe"
      },
      {
        "field": "ED_CommandLine",
        "op": "contains",
        "value": "Everyone:F"
      }
    ]
}