{
    "rule_title": "TTP 1053.005 - New Persistence Task Registered",
    "description": "Detects a new scheduled task registration, excluding standard Microsoft Windows background tasks.",
    "logic": "AND",
    "severity": "high",
    "detection": [
      {
        "field": "EventID",
        "op": "eq",
        "value": "4698"
      },
      {
        "field": "Channel",
        "op": "eq",
        "value": "Security"
      },
      {
        "field": "ED_TaskContent",
        "op": "contains",
        "value": "<Enabled>true</Enabled>"
      }
    ]
}