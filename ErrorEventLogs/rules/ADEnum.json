{
    "rule_title": "TTP 1087.002 - LDAP Domain Enumeration via PowerShell ADModule or ADSI",
    "description": "Detects PowerShell-based AD enumeration using the ActiveDirectory module or ADSI queries — used by attackers without access to external tools like BloodHound to enumerate users, computers, and group membership directly.",
    "logic": "AND",
    "severity": "medium",
    "detection": [
      { "field": "EventID", "op": "in", "value": ["4104", "800"] },
      { "field": "Channel", "op": "in", "value": ["Microsoft-Windows-PowerShell/Operational", "Windows PowerShell"] },
      { "field": "ED_ScriptBlockText", "op": "contains_any", "value": [
          "Get-ADUser",
          "Get-ADComputer",
          "Get-ADGroup",
          "Get-ADGroupMember",
          "Get-ADDomain",
          "Get-ADTrust",
          "Get-ADForest",
          "[adsisearcher]",
          "DirectorySearcher",
          "System.DirectoryServices",
          "Get-LocalGroupMember",
        "Get-LocalGroups",
          "Get-LocalUser"
        ]
      }
    ]
}