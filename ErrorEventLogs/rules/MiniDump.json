  {
    "rule_title": "TTP 1003.001 - LSASS Credential Dump via comsvcs.dll MiniDump LOLBin",
    "description": "Detects use of rundll32.exe to invoke the MiniDump export of comsvcs.dll against a target process. This is a well-known living-off-the-land credential access technique used to dump LSASS memory to disk without requiring Mimikatz or ProcDump. The resulting .dmp file can be parsed offline to extract plaintext passwords, NTLM hashes, and Kerberos tickets. Near-zero legitimate use. Typically preceded by 'tasklist /fi \"imagename eq lsass.exe\"' to locate the LSASS PID. Requires Security EID 4688 with command line auditing enabled, or Sysmon EID 1.",
    "logic": "OR",
    "severity": "high",
    "detection": [
      {
        "logic": "AND",
        "detection": [
          {
            "field": "EventID",
            "op": "eq",
            "value": "4688"
          },
          {
            "field": "Channel",
            "op": "eq",
            "value": "Security"
          },
          {
            "field": "ED_NewProcessName",
            "op": "contains",
            "value": "rundll32.exe"
          },
          {
            "field": "ED_CommandLine",
            "op": "contains",
            "value": "comsvcs.dll"
          },
          {
            "field": "ED_CommandLine",
            "op": "contains",
            "value": "MiniDump"
          }
        ]
      },
      {
        "logic": "AND",
        "detection": [
          {
            "field": "EventID",
            "op": "eq",
            "value": "1"
          },
          {
            "field": "Channel",
            "op": "eq",
            "value": "Microsoft-Windows-Sysmon/Operational"
          },
          {
            "field": "ED_Image",
            "op": "contains",
            "value": "rundll32.exe"
          },
          {
            "field": "ED_CommandLine",
            "op": "contains",
            "value": "comsvcs.dll"
          },
          {
            "field": "ED_CommandLine",
            "op": "contains",
            "value": "MiniDump"
          }
        ]
      },
      {
        "logic": "AND",
        "detection": [
          {
            "field": "EventID",
            "op": "eq",
            "value": "4104"
          },
          {
            "field": "Channel",
            "op": "eq",
            "value": "Microsoft-Windows-PowerShell/Operational"
          },
          {
            "field": "ED_ScriptBlockText",
            "op": "contains",
            "value": "comsvcs.dll"
          },
          {
            "field": "ED_ScriptBlockText",
            "op": "contains",
            "value": "MiniDump"
          }
        ]
      }
    ]
  }