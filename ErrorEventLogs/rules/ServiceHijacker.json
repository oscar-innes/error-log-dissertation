
   { "rule_title": "TTP 1574.010 - Service Binary Path Hijacked via sc, reg, or PowerShell",
    "description": "Detects modification of a service ImagePath to point to a non-standard executable — the service binary path hijacking persistence and privilege escalation technique. Covers all three observed delivery methods: sc.exe config binPath, reg.exe add ImagePath, and PowerShell Set-ItemProperty targeting ImagePath in the services registry hive.",
    "logic": "OR",
    "severity": "medium",
    "detection": [
      {
        "logic": "AND",
        "detection": [
          { "field": "EventID", "op": "eq", "value": "4688" },
          { "field": "Channel", "op": "eq", "value": "Security" },
        { "field": "ED_NewProcessName", "op": "endswith", "value": "\\sc.exe" },
        { "field": "ED_CommandLine", "op": "in", "value": ["binPath=", "command="] }
        ]
      },
      {
        "logic": "AND",
        "detection": [
          { "field": "EventID", "op": "eq", "value": "4688" },
          { "field": "Channel", "op": "eq", "value": "Security" },
          { "field": "ED_NewProcessName", "op": "endswith", "value": "\\reg.exe" },
          { "field": "ED_CommandLine", "op": "contains", "value": "\\Services\\" },
          { "field": "ED_CommandLine", "op": "in", "value": ["ImagePath", "FailureCommand"] }
        ]
      },
      {
        "logic": "AND",
        "detection": [
          { "field": "EventID", "op": "eq", "value": "4104" },
          { "field": "Channel", "op": "eq", "value": "Microsoft-Windows-PowerShell/Operational" },
          { "field": "ED_ScriptBlockText", "op": "contains", "value": "\\services\\" },
          { "field": "ED_ScriptBlockText", "op": "in", "value": ["ImagePath", "FailureCommand"] }
        ]
      }
    ]
  }